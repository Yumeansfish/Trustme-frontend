{
  "name": "trust-me-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend for Trust-me built with Vue.",
  "author": "Trust-me contributors",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "npm run test:node",
    "lint": "eslint src test scripts vite.config.ts",
    "typecheck": "npm run typecheck:ts && npm run typecheck:vue",
    "typecheck:ts": "tsc -p tsconfig.json --noEmit",
    "typecheck:vue": "vue-tsc -p tsconfig.vue.json --noEmit",
    "test:node": "jest --config jest.node.config.cjs --runInBand",
    "test:ui": "jest --config jest.ui.config.cjs --runInBand",
    "test:routes": "node scripts/smoke-route-components.mjs",
    "test:components": "npm run test:ui && npm run test:routes",
    "test:ci": "npm run contracts:check && npm run lint && npm run typecheck && npm run test:node && npm run test:components && npm run build",
    "contracts:write": "python3 ../scripts/sync_frontend_contracts.py --write",
    "contracts:check": "python3 ../scripts/sync_frontend_contracts.py --check"
  },
  "dependencies": {
    "aw-client": "^0.3.7",
    "axios": "^1.18.1",
    "chart.js": "^3.9.1",
    "lucide-vue-next": "^0.577.0",
    "moment": "^2.30.1",
    "papaparse": "^5.3.2",
    "pinia": "^3.0.4",
    "typeface-varela-round": "0.0.54",
    "vue": "^3.5.29",
    "vue-chartjs": "^4.1.2",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/jest": "^29",
    "@types/node": "^20.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.11",
    "@vue/vue3-jest": "^29.2.6",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "globals": "^17.8.0",
    "jest": "^29",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29",
    "jsdom": "^21.1.1",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.2.1",
    "ts-jest": "^29",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.1",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^3.3.7"
  }
}
